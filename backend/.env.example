# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=staz
DB_PASSWORD=staz
DB_DATABASE=staz

PORT=3000

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# Migrazione dati pre-esistenti al proprietario (solo avvio locale)
LEGACY_OWNER_EMAIL=
LEGACY_OWNER_FIRST_NAME=
LEGACY_OWNER_LAST_NAME=
LEGACY_OWNER_USERNAME=
LEGACY_OWNER_PASSWORD=

# ─── Scout Multigol (unica fonte dati calcio) ───────────────
# https://dashboard.api-football.com/
API_FOOTBALL_KEY=

# ─── Betwatch (demo scommesse finte su Betfair) ─────────────
# https://betwatch.fr/subscription/api
# La chiave può stare anche in locale, ma il polling parte solo sul server
# (NODE_ENV=production). BETWATCH_POLL=0 lo spegne anche lì.
BETWATCH_API_KEY=
# BETWATCH_POLL_SECONDS=60

# Notifica Telegram quando parte una scommessa finta. Il token arriva da @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Loghi squadre (ricerca in Nuova Scommessa) ─────────────
# https://sports.bzzoiro.com/
BZZOIRO_SPORTS_API_KEY=

# Opzionali scout:
# MULTIGOL_CACHE_HOURS=12
# Leghe scout: default = ~35 campionati (SA,SB,TR1,CH1,DK1,NO1,…). Override:
# MULTIGOL_SCOUT_LEAGUE_CODES=SA,SB,PL,UCL,UEL,UECL,TR1
# MULTIGOL_SCOUT_LEAGUE_CODES=ALL
# MULTIGOL_SCOUT_LIST_EMPIRICAL=false
# MULTIGOL_SCOUT_XG=false
# Pausa tra chiamate API-Football (ms). Alza se vedi rateLimit in console (es. 800–1200).
# API_FOOTBALL_MIN_MS=450
# Aprire la pagina Scout NON riscanisce le leghe (legge PostgreSQL). Solo Aggiorna o cron.
# POST /multigol-scout/snapshot/refresh?leagues=UCL,UEL,UECL — aggiorna solo quelle leghe (merge DB)
# npm run multigol:refresh-uefa — CLI locale + scout-multigol-uefa-cups.sql
# MULTIGOL_SCOUT_SCAN_ON_READ=false
# Cron notturno ore 03:00 Europe/Rome: calcola sempre le partite del giorno dopo
# Giorni ricalcolati (da oggi) al primo avvio dopo un cambio di versione del modello (1-7)
# MULTIGOL_RECALC_DAYS=1
# MULTIGOL_SCOUT_NIGHTLY_CRON=true
# MULTIGOL_TEAM_FORM_LIMIT=100
